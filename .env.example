# ============================================
# Backend Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values

# ----- Models & Runtime -----

# Embedding Model
EMBED_MODEL=intfloat/e5-base-v2
# Options:
#   - sentence-transformers/all-MiniLM-L6-v2 (fast, 80MB)
#   - intfloat/e5-base-v2 (better quality, 120MB)
#   - BAAI/bge-small-en-v1.5 (best quality, 120MB)

# Answer LLM
LLM_MODEL=llama3
LLM_BACKEND=openrouter  # ollama | gemini | openrouter

# Structured routing / standalone-query rewrite.
# Use a smaller/cheaper model here when available. If omitted, ROUTER_BACKEND
# falls back to LLM_BACKEND and ROUTER_MODEL falls back to that provider's model.
QUERY_ROUTER_ENABLED=true
ROUTER_BACKEND=openrouter
ROUTER_MODEL=xiaomi/mimo-v2-flash:free
ROUTER_CONTEXT_MAX_CHARS=8000

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=xiaomi/mimo-v2-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=60

# Ollama (if using local)
OLLAMA_BASE=http://localhost:11434
OLLAMA_TIMEOUT_SEC=120
OLLAMA_MAX_RETRIES=2
OLLAMA_BACKOFF_BASE=2

# Google Gemini (alternative)
GENAI_API_KEY=your-gemini-api-key
GENAI_MODEL=gemini-2.5-flash
GENAI_TIMEOUT_SEC=60

# ----- Vector Store -----

CHROMA_PATH=./chroma

# ----- Search Configuration -----

SEARCH_PROVIDER=arxiv
SEARCH_MAX_RESULTS=5
CACHE_TTL_HOURS=48
TAVILY_API_KEY=your-tavily-key
ENABLE_QUERY_REWRITE=true
ENABLE_SEMANTIC_RERANK_ARXIV=true

# ----- Production Research Workflow -----

# Only gates /api/research/preview. /api/chat and /api/chat/stream use the
# research workflow as the canonical retrieval-backed chat path.
RESEARCH_WORKFLOW_ENABLED=false
RESEARCH_DISCOVERY_PROVIDERS=arxiv,semantic_scholar,openalex
RESEARCH_ENABLE_FULLTEXT_FETCH=false
RESEARCH_ENABLE_GRAPH=false
RESEARCH_ENABLE_PHOENIX=false
# Only affects /api/research/preview. Chat paths always generate real answers.
RESEARCH_PREVIEW_GENERATE=false
RESEARCH_ARXIV_MIN_INTERVAL_SECONDS=3.2
RESEARCH_ARXIV_CACHE_DIR=.cache/research/arxiv
RESEARCH_ARXIV_CACHE_TTL_SECONDS=604800
RESEARCH_SEMANTIC_SCHOLAR_CACHE_DIR=.cache/research/semantic_scholar
RESEARCH_SEMANTIC_SCHOLAR_CACHE_TTL_SECONDS=86400
RESEARCH_SEMANTIC_SCHOLAR_MAX_RETRIES=3
RESEARCH_SEMANTIC_SCHOLAR_BACKOFF_BASE_SECONDS=1.0
RESEARCH_SEMANTIC_SCHOLAR_BACKOFF_MAX_SECONDS=60
RESEARCH_SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.0
RESEARCH_OPENALEX_CACHE_DIR=.cache/research/openalex
RESEARCH_OPENALEX_CACHE_TTL_SECONDS=86400
RESEARCH_OPENALEX_MAX_RETRIES=3
RESEARCH_OPENALEX_BACKOFF_BASE_SECONDS=1.0
RESEARCH_OPENALEX_BACKOFF_MAX_SECONDS=60
RESEARCH_OPENALEX_MIN_INTERVAL_SECONDS=1.0
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# ----- Ingestion -----

CHUNK_SIZE=1024
CHUNK_OVERLAP=100
INDEX_BATCH_SIZE=64
MAX_CONTENT_MB=2
CRAWL_TIMEOUT_SEC=15
CRAWL_MAX_RETRIES=2
CRAWL_BACKOFF_BASE_SEC=2

# ----- Legacy Adaptive-RAG Retrieval -----
# The production research workflow has its own discovery/ranking pipeline.
# These settings remain for the legacy LangGraph path.

TOP_K=6
USE_BM25=true
RRF_K=60
KB_CONFIDENCE_THRESHOLD=0.6
KB_RELEVANCE_THRESHOLD=0.3
ENABLE_RERANKING=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=6
RERANK_THRESHOLD=0.0
RERANK_SCORE_DROP=999.0
RERANK_MAX_TEXT_LENGTH=400

# ----- Model Preloading -----

PRELOAD_MODELS=true
PRELOAD_EMBED_MODEL=true
PRELOAD_RERANK_MODEL=true

# ----- System Prompt -----

USE_ENGLISH_PROMPT=true

# ----- Logging -----

LOG_LEVEL=INFO

# ----- API Server Configuration -----

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.vercel.app,https://*.trycloudflare.com

# ----- Memory / Conversation Context -----
# docker-compose enables the production flags below and wires MEMORY_DATABASE_URL
# to pgvector/Postgres. If you run the API without docker-compose, explicitly
# configure a database before treating memory as durable across processes.

PERSISTENT_TRANSCRIPT_ENABLED=false
SESSION_SUMMARY_ENABLED=false
LONG_TERM_MEMORY_ENABLED=false
RESEARCH_MEMORY_ENABLED=false
CONVERSATIONAL_MEMORY_ENABLED=false
MEMORY_DATABASE_URL=
MEMORY_RECENT_MESSAGE_LIMIT=8
MEMORY_MAX_CONTEXT_CHARS=12000
# Bounded recent user-scoped durable preferences/facts included in context even
# when the current query has no lexical overlap with the stored preference.
USER_PROFILE_MEMORY_LIMIT=5

# Legacy in-process session cache bounds (compatibility only; not durable memory)
SESSIONS_MAX=500
SESSIONS_TTL_SECONDS=3600

# Docker Compose Postgres defaults for local durable memory.
# Use stronger credentials outside local development.
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research_memory
POSTGRES_PORT=5432
# Server-to-server API trust (use the same random value in the Next.js server)
APP_ENV=development
BACKEND_INTERNAL_TOKEN=<set-a-random-value>
