# Models & Runtime
EMBED_MODEL=intfloat/e5-base-v2
LLM_MODEL=llama3
LLM_BACKEND=ollama  # options: ollama | gemini | openrouter
OLLAMA_BASE=http://localhost:11434
OLLAMA_TIMEOUT_SEC=120
OLLAMA_MAX_RETRIES=2
OLLAMA_BACKOFF_BASE=2
GENAI_API_KEY=
GENAI_MODEL=gemini-2.5-flash
GENAI_TIMEOUT_SEC=60
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=60

# Vector store
CHROMA_PATH=./chroma

# Search
SEARCH_PROVIDER=arxiv
SEARCH_MAX_RESULTS=5
CACHE_TTL_HOURS=48
TAVILY_API_KEY=  # Get free API key at https://tavily.com
ENABLE_QUERY_REWRITE=true  # Use LLM to rewrite queries for better search results

# Ingestion
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
INDEX_BATCH_SIZE=64
MAX_CONTENT_MB=2
CRAWL_TIMEOUT_SEC=15
CRAWL_MAX_RETRIES=2
CRAWL_BACKOFF_BASE_SEC=2

# Retrieval
TOP_K=6
USE_BM25=true
RRF_K=60
KB_CONFIDENCE_THRESHOLD=0.6  # Lowered from 0.7 for more lenient routing
KB_RELEVANCE_THRESHOLD=0.3  # Lowered from 0.5 for better recall (minimum similarity to consider a doc relevant)
USE_LLM_INTENT=false  # Use LLM for intent classification when confidence is low
ENABLE_RERANKING=true  # Re-rank retrieved snippets using cross-encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2  # Alternatives: BAAI/bge-reranker-base, mixedbread-ai/mxbai-rerank-base-v1
RERANK_TOP_K=6  # Number of snippets to keep after re-ranking
RERANK_THRESHOLD=0.0  # Minimum relevance score (0.0 = disable filtering, only reorder)
RERANK_SCORE_DROP=999.0  # Max score drop for dynamic cutoff (999 = disable dynamic cutoff)
RERANK_MAX_TEXT_LENGTH=400  # Max text length for rerank (shorter = better for MiniLM-L6, default: 400 tokens/chars)

# Model Preloading (reduce cold start latency)
PRELOAD_MODELS=false              # Master flag to enable model preloading
PRELOAD_EMBED_MODEL=false         # Preload embedding model at startup
PRELOAD_RERANK_MODEL=false        # Preload rerank model at startup

# System Prompt
USE_ENGLISH_PROMPT=true           # Use English prompt (recommended for better performance)
                                  # Set to false to use Vietnamese prompt
# HuggingFace Tokenizers
TOKENIZERS_PARALLELISM=false  # Set to false to avoid forking warnings (recommended for uvicorn --reload)

# Misc
LOG_LEVEL=INFO

# ============================================
# API Server Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
